@model KoleProducoes.Domain.Entities.Appointment

@{
    ViewData["Title"] = "Detalhes do Agendamento";
    ViewData["ActiveMenu"] = "appointments";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <script>window.addEventListener('load', () => showToast('@TempData["Success"]'));</script>
}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:900px">

    <div class="table-wrap">
        <div class="table-header">
            <div class="section-heading">Dados do Cliente</div>
        </div>
        <div style="padding:20px;display:flex;flex-direction:column;gap:14px">

            <div>
                <div class="kpi-label">Nome</div>
                <div>@Model.ClientName</div>
            </div>
            <div>
                <div class="kpi-label">E-mail</div>
                <div>@Model.Email</div>
            </div>
            <div>
                <div class="kpi-label">Telefone</div>
                <div>@Model.Phone</div>
            </div>
            <div>
                <div class="kpi-label">Interesse</div>
                <div>
                    @switch (Model.InterestType)
                    {
                        case KoleProducoes.Domain.Entities.InterestType.HireShow:
                            <span>Contratar Show</span>
                            break;
                        case KoleProducoes.Domain.Entities.InterestType.OrganizeEvent:
                            <span>Organizar Evento</span>
                            break;
                        case KoleProducoes.Domain.Entities.InterestType.CommercialPartnership:
                            <span>Parceria Comercial</span>
                            break;
                        default:
                            <span>Outro</span>
                            break;
                    }
                </div>
            </div>
            <div>
                <div class="kpi-label">Horário Solicitado</div>
                <div>@Model.RequestedDateTime.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div>
                    <div class="kpi-label">Mensagem</div>
                    <div style="color:var(--gray-lighter)">@Model.Message</div>
                </div>
            }
            <div>
                <div class="kpi-label">Solicitado em</div>
                <div style="color:var(--gray-light)">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>
    </div>

    <div class="table-wrap">
        <div class="table-header">
            <div class="section-heading">Atualizar Status</div>
        </div>
        <div style="padding:20px">

            <div style="margin-bottom:20px">
                <div class="kpi-label">Status Atual</div>
                <div style="margin-top:6px">
                    @switch (Model.Status)
                    {
                        case KoleProducoes.Domain.Entities.AppointmentStatus.Pending:
                            <span class="badge badge-yellow">Pendente</span>
                            break;
                        case KoleProducoes.Domain.Entities.AppointmentStatus.Confirmed:
                            <span class="badge badge-green">Confirmado</span>
                            break;
                        case KoleProducoes.Domain.Entities.AppointmentStatus.Cancelled:
                            <span class="badge badge-red">Cancelado</span>
                            break;
                        case KoleProducoes.Domain.Entities.AppointmentStatus.Completed:
                            <span class="badge badge-gray">Realizado</span>
                            break;
                    }
                </div>
            </div>

            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="form-group">
                    <label>Novo Status</label>
                    <select name="Status">
                        <option value="1">Pendente</option>
                        <option value="2">Confirmado</option>
                        <option value="3">Cancelado</option>
                        <option value="4">Realizado</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Observação Interna</label>
                    <textarea name="InternalNotes" rows="3"
                              placeholder="Notas internas (não visível ao cliente)...">@Model.InternalNotes</textarea>
                </div>

                <div style="display:flex;justify-content:space-between;margin-top:16px">
                    <a asp-action="Index" class="btn-outline">← Voltar</a>
                    <button type="submit" class="btn">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('select[name="Status"]').value = '@((int)Model.Status)';
    </script>
}