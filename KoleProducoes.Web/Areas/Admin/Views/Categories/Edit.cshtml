@model KoleProducoes.Web.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Editar Categoria";
    ViewData["ActiveMenu"] = "categories";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="table-wrap" style="max-width:600px">
    <div class="table-header">
        <div class="section-heading">Editar Categoria</div>
        <a asp-action="Index" class="btn-outline">← Voltar</a>
    </div>

    <div style="padding:24px">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Name">Nome</label>
                <input asp-for="Name" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Descrição</label>
                <textarea asp-for="Description" rows="3"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Type">Tipo</label>
                <select asp-for="Type">
                    <option value="1">Produto</option>
                    <option value="2">Serviço</option>
                    <option value="3">Contratação</option>
                </select>
                <span asp-validation-for="Type" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Order">Ordem de exibição</label>
                <input asp-for="Order" type="number" min="0" />
            </div>

            <div class="form-group" style="flex-direction:row;align-items:center;gap:10px">
                <input asp-for="IsActive" type="checkbox" style="width:auto" />
                <label asp-for="IsActive" style="text-transform:none;letter-spacing:0;font-size:0.88rem">
                    Categoria ativa
                </label>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px;padding-top:20px;border-top:1px solid var(--border)">
                <a asp-action="Index" class="btn-outline">Cancelar</a>
                <button type="submit" class="btn">Salvar Alterações</button>
            </div>

        </form>
    </div>
</div>