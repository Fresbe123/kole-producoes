@model KoleProducoes.Web.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Editar Produto";
    ViewData["ActiveMenu"] = "products";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="table-wrap" style="max-width:800px">
    <div class="table-header">
        <div class="section-heading">Editar Produto</div>
        <a asp-action="Index" class="btn-outline">← Voltar</a>
    </div>

    <div style="padding:24px">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">

                <div class="form-group" style="grid-column:1/-1">
                    <label asp-for="Name">Nome do Produto</label>
                    <input asp-for="Name" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId">Categoria</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories">
                        <option value="">Selecione...</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DailyRate">Valor da Diária (R$)</label>
                    <input asp-for="DailyRate" type="number" step="0.01" />
                    <span asp-validation-for="DailyRate" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="StockQuantity">Quantidade em Estoque</label>
                    <input asp-for="StockQuantity" type="number" min="0" />
                    <span asp-validation-for="StockQuantity" class="field-validation-error"></span>
                </div>

                <div class="form-group" style="grid-column:1/-1">
                    <label asp-for="Description">Descrição</label>
                    <textarea asp-for="Description" rows="4"></textarea>
                    <span asp-validation-for="Description" class="field-validation-error"></span>
                </div>

                <div class="form-group" style="flex-direction:row;align-items:center;gap:10px">
                    <input asp-for="IsAvailable" type="checkbox" style="width:auto" />
                    <label asp-for="IsAvailable" style="text-transform:none;letter-spacing:0;font-size:0.88rem">
                        Disponível para locação
                    </label>
                </div>

                <div class="form-group" style="flex-direction:row;align-items:center;gap:10px">
                    <input asp-for="IsActive" type="checkbox" style="width:auto" />
                    <label asp-for="IsActive" style="text-transform:none;letter-spacing:0;font-size:0.88rem">
                        Produto ativo
                    </label>
                </div>

            </div>

            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px;padding-top:20px;border-top:1px solid var(--border)">
                <a asp-action="Index" class="btn-outline">Cancelar</a>
                <button type="submit" class="btn">Salvar Alterações</button>
            </div>

        </form>
    </div>
</div>