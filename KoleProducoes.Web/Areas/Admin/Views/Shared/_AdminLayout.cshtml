@using Microsoft.AspNetCore.Identity
@inject SignInManager<KoleProducoes.Infrastructure.Data.ApplicationUser> SignInManager
@inject UserManager<KoleProducoes.Infrastructure.Data.ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — Kole Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Barlow:wght@300;400;500;600&family=Barlow+Condensed:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-logo">
            <div class="sidebar-logo-name">KOLE <span>Produções</span></div>
            <div class="sidebar-logo-sub">Painel Administrativo</div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">Principal</div>

            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "dashboard" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
                Dashboard
            </a>

            <div class="nav-section">Conteúdo</div>

            <a asp-area="Admin" asp-controller="Shows" asp-action="Index"
               class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "shows" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polygon points="5,3 19,12 5,21" />
                </svg>
                Shows
            </a>

            <a asp-area="Admin" asp-controller="Products" asp-action="Index"
               class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "products" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                </svg>
                Produtos
            </a>

            <a asp-area="Admin" asp-controller="DJs" asp-action="Index"
               class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "djs" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="3" />
                    <circle cx="12" cy="12" r="9" />
                </svg>
                DJs
            </a>

            <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
               class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "categories" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <line x1="8" y1="6" x2="21" y2="6" />
                    <line x1="8" y1="12" x2="21" y2="12" />
                    <line x1="8" y1="18" x2="21" y2="18" />
                    <circle cx="3" cy="6" r="1" />
                    <circle cx="3" cy="12" r="1" />
                    <circle cx="3" cy="18" r="1" />
                </svg>
                Categorias
            </a>

            <div class="nav-section">Operações</div>

            <a asp-area="Admin" asp-controller="Appointments" asp-action="Index"
               class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "appointments" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                Agendamentos
                @if (ViewData["PendingAppointments"] is int pending && pending > 0)
                {
                    <span class="nav-badge">@pending</span>
                }
            </a>

            <div class="nav-section">Sistema</div>

            <a asp-area="Admin" asp-controller="Users" asp-action="Index"
               class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "users" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                Usuários
            </a>

            <a asp-area="Admin" asp-controller="History" asp-action="Index"
               class="nav-item @(ViewData["ActiveMenu"]?.ToString() == "history" ? "active" : "")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 3v5h5" />
                    <path d="M3.05 13A9 9 0 1 0 6 5.3L3 8" />
                    <path d="M12 7v5l4 2" />
                </svg>
                Histórico
            </a>

        </nav>

        <div class="sidebar-user">
            <div class="user-avatar">
                @{
                    var currentUser = await UserManager.GetUserAsync(User);
                    var initials = currentUser?.FullName?.Length > 1
                    ? currentUser.FullName.Substring(0, 2).ToUpper()
                    : "AD";
                }
                @initials
            </div>
            <div class="user-info">
                <div class="user-name">@currentUser?.FullName</div>
                <div class="user-role">
                    @(User.IsInRole("Administrator") ? "Administrador" : "Editor")
                </div>
            </div>
        </div>
    </aside>

    <main class="main-content">

        <header class="topbar">
            <button class="topbar-toggle" onclick="toggleSidebar()" aria-label="Menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <line x1="3" y1="18" x2="21" y2="18" />
                </svg>
            </button>
            <div class="topbar-title">@ViewData["Title"]</div>
            <div class="topbar-actions">
                <a href="/" target="_blank" class="topbar-link" title="Ver site público">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                        <polyline points="15,3 21,3 21,9" />
                        <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                </a>
                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="topbar-link" title="Sair">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16,17 21,12 16,7" />
                            <line x1="21" y1="12" x2="9" y2="12" />
                        </svg>
                    </button>
                </form>
            </div>
        </header>

        <div class="content-area">
            @RenderBody()
        </div>
    </main>

    <div class="toast" id="toast"></div>

    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>