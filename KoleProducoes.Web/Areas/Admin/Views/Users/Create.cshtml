@model KoleProducoes.Web.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Novo Usuário";
    ViewData["ActiveMenu"] = "users";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="table-wrap" style="max-width:600px">
    <div class="table-header">
        <div class="section-heading">Novo Usuário</div>
        <a asp-action="Index" class="btn-outline">← Voltar</a>
    </div>

    <div style="padding:24px">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="login-error" style="margin-bottom:20px">
                    @Html.ValidationSummary(false)
                </div>
            }

            <div class="form-group">
                <label asp-for="FullName">Nome Completo</label>
                <input asp-for="FullName" placeholder="Ex: João Silva" />
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">E-mail</label>
                <input asp-for="Email" type="email" placeholder="joao@koleproducoes.com.br" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role">Perfil de Acesso</label>
                <select asp-for="Role">
                    <option value="Administrator">Administrador — acesso total</option>
                    <option value="Editor">Editor — shows e produtos apenas</option>
                </select>
                <span asp-validation-for="Role" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Senha</label>
                <input asp-for="Password" type="password" placeholder="Mínimo 8 caracteres" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirmar Senha</label>
                <input asp-for="ConfirmPassword" type="password" placeholder="Repita a senha" />
                <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px;padding-top:20px;border-top:1px solid var(--border)">
                <a asp-action="Index" class="btn-outline">Cancelar</a>
                <button type="submit" class="btn">Criar Usuário</button>
            </div>

        </form>
    </div>
</div>