@model KoleProducoes.Web.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Editar Usuário";
    ViewData["ActiveMenu"] = "users";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="table-wrap" style="max-width:600px">
    <div class="table-header">
        <div class="section-heading">Editar Usuário</div>
        <a asp-action="Index" class="btn-outline">← Voltar</a>
    </div>

    <div style="padding:24px">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="login-error" style="margin-bottom:20px">
                    @Html.ValidationSummary(false)
                </div>
            }

            <div class="form-group">
                <label asp-for="FullName">Nome Completo</label>
                <input asp-for="FullName" />
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">E-mail</label>
                <input asp-for="Email" type="email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role">Perfil de Acesso</label>
                <select asp-for="Role">
                    <option value="Administrator">Administrador — acesso total</option>
                    <option value="Editor">Editor — shows e produtos apenas</option>
                </select>
            </div>

            <div style="border-top:1px solid var(--border);padding-top:20px;margin-top:8px">
                <div class="section-heading" style="margin-bottom:16px">
                    Alterar Senha
                </div>
                <div style="font-size:0.82rem;color:var(--gray-light);margin-bottom:16px">
                    Deixe em branco para manter a senha atual.
                </div>

                <div class="form-group">
                    <label asp-for="Password">Nova Senha</label>
                    <input asp-for="Password" type="password" placeholder="Mínimo 8 caracteres" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirmar Nova Senha</label>
                    <input asp-for="ConfirmPassword" type="password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px;padding-top:20px;border-top:1px solid var(--border)">
                <a asp-action="Index" class="btn-outline">Cancelar</a>
                <button type="submit" class="btn">Salvar Alterações</button>
            </div>

        </form>
    </div>
</div>