<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] — Kole Produções</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Kole Produções — Produção de eventos, shows e locação de equipamentos.")">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Barlow:wght@300;400;500;600&family=Barlow+Condensed:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- NAVBAR -->
    <nav>
        <a asp-controller="Home" asp-action="Index" class="nav-logo">KOLE <span>Produções</span></a>
        <ul class="nav-links">
            <li><a asp-controller="Shows" asp-action="Index">Shows</a></li>
            <li><a asp-controller="Shows" asp-action="History">Histórico</a></li>
            <li><a asp-controller="Products" asp-action="Index">Locação</a></li>
            <li><a asp-controller="DJs" asp-action="Index">DJs</a></li>
            <li><a asp-controller="Appointment" asp-action="Index" class="nav-cta">Agendar Reunião</a></li>
        </ul>
        <button class="hamburger" onclick="toggleMenu()" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>
    </nav>

    <!-- MOBILE MENU -->
    <div class="mobile-menu" id="mobileMenu">
        <button class="close-menu" onclick="toggleMenu()">×</button>
        <a asp-controller="Shows" asp-action="Index" onclick="toggleMenu()">Shows</a>
        <a asp-controller="Shows" asp-action="History" onclick="toggleMenu()">Histórico</a>
        <a asp-controller="Products" asp-action="Index" onclick="toggleMenu()">Locação</a>
        <a asp-controller="DJs" asp-action="Index" onclick="toggleMenu()">DJs</a>
        <a asp-controller="Appointment" asp-action="Index" onclick="toggleMenu()">Agendar Reunião</a>
    </div>

    @RenderBody()

    <!-- FOOTER -->
    <footer>
        <div class="footer-logo">KOLE <span style="font-weight:400;opacity:0.5">Produções</span></div>
        <ul class="footer-links">
            <li><a asp-controller="Shows" asp-action="Index">Shows</a></li>
            <li><a asp-controller="Products" asp-action="Index">Locação</a></li>
            <li><a asp-controller="DJs" asp-action="Index">DJs</a></li>
            <li><a asp-controller="Appointment" asp-action="Index">Agendar</a></li>
        </ul>
        <div class="footer-copy">© @DateTime.Now.Year Kole Produções. Todos os direitos reservados.</div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>