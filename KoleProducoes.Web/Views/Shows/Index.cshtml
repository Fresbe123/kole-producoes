@model IEnumerable<KoleProducoes.Domain.Entities.Show>

@{
    ViewData["Title"] = "Próximos Shows";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categories = ViewData["Categories"] as IEnumerable<KoleProducoes.Domain.Entities.Category>;
    var currentCategory = ViewData["CurrentCategory"]?.ToString();
}

<!-- HEADER DA PÁGINA -->
<section style="padding-top:140px;padding-bottom:0;background:var(--black);border-bottom:1px solid var(--border)">
    <div style="padding:0 48px 48px">

        <div class="hero-eyebrow">Agenda</div>

        <h1 style="font-family:'Playfair Display',serif;font-size:clamp(2.5rem,6vw,5rem);font-weight:900;line-height:0.95;letter-spacing:-0.02em;margin-top:20px;margin-bottom:48px">
            Próximos<br>
            <em style="font-style:italic;color:transparent;-webkit-text-stroke:1.5px var(--white)">Shows</em>
        </h1>

        @if (categories != null && categories.Any())
        {
            <div style="display:flex;gap:12px;flex-wrap:wrap">
                <a asp-action="Index"
                   class="filter-category @(string.IsNullOrEmpty(currentCategory) ? "active" : "inactive")">
                    Todos
                </a>
                @foreach (var cat in categories)
                {
                    <a asp-action="Index" asp-route-category="@cat.Name"
                       class="filter-category @(currentCategory == cat.Name ? "active" : "inactive")">
                        @cat.Name
                    </a>
                }
            </div>
        }
    </div>
</section>

<!-- LISTA DE SHOWS -->
<section style="background:var(--gray-dark);padding-top:60px">
    @if (Model.Any())
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(380px,1fr));gap:2px">
            @foreach (var show in Model)
            {
                <a asp-action="Details" asp-route-slug="@show.Slug"
                   class="show-card @(show.Status == KoleProducoes.Domain.Entities.ShowStatus.Featured ? "destaque" : "") fade-up">

                    <div class="show-tag">
                        @if (show.Status == KoleProducoes.Domain.Entities.ShowStatus.Featured)
                        {
                            <div class="tag-dot"></div>
                            <span>Destaque</span>
                        }
                        else
                        {
                            <span>@show.DateTime.ToString("MMM yyyy", new System.Globalization.CultureInfo("pt-BR")).ToUpper()</span>
                        }
                    </div>

                    <div class="show-artist">@show.ArtistName</div>
                    <div class="show-name">@show.ShowName</div>

                    <div class="show-meta">
                        <div class="show-meta-item">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="4" width="18" height="18" rx="2" />
                                <line x1="16" y1="2" x2="16" y2="6" />
                                <line x1="8" y1="2" x2="8" y2="6" />
                                <line x1="3" y1="10" x2="21" y2="10" />
                            </svg>
                            @show.DateTime.ToString("dd 'de' MMMM 'de' yyyy 'às' HH:mm'h'",
                            new System.Globalization.CultureInfo("pt-BR"))
                </div>
                <div class="show-meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                        <circle cx="12" cy="10" r="3" />
                    </svg>
                    @show.Venue — @show.City
                </div>
                @if (show.Category != null)
                        {
                            <div class="show-meta-item">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <line x1="8" y1="6" x2="21" y2="6" />
                                    <line x1="8" y1="12" x2="21" y2="12" />
                                    <line x1="8" y1="18" x2="21" y2="18" />
                                    <circle cx="3" cy="6" r="1" />
                                    <circle cx="3" cy="12" r="1" />
                                    <circle cx="3" cy="18" r="1" />
                                </svg>
                                @show.Category.Name
                            </div>
                        }
                </div>

                <div class="show-footer">
                    <div class="show-price">
                        @(show.StartingPrice.HasValue
                                            ? $"A partir de R$ {show.StartingPrice:N2}"
                                            : "Consulte")
                </div>
                <span class="show-btn">Ver detalhes →</span>
            </div>
        </a>
                }
        </div>
    }
    else
    {
        <div style="text-align:center;padding:80px 48px;color:var(--gray-light)">
            <p style="font-family:'Playfair Display',serif;font-size:1.5rem;margin-bottom:16px">
                Nenhum show encontrado
            </p>
            <p style="margin-bottom:32px">
                Novos shows em breve. Agende uma reunião para saber mais.
            </p>
            <a asp-controller="Appointment" asp-action="Index" class="btn-primary">
                Agendar Reunião
            </a>
        </div>
    }
</section>